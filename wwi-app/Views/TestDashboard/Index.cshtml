// ── Sort ───────────────────────────────────────────────────────────────────
var sort={col:null,dir:1};
function sortTable(col){
    sort.dir=sort.col===col?sort.dir*-1:1; sort.col=col;
    var tbody=document.getElementById('test-tbody');
    var rows=Array.from(tbody.querySelectorAll('tr[data-key]'));
    rows.sort(function(a,b){
        if(col==='duration') return (parseFloat(a.getAttribute('data-duration')||0)-parseFloat(b.getAttribute('data-duration')||0))*sort.dir;
        var m={method:'data-key',class:'data-class',status:'data-outcome'};
        return (a.getAttribute(m[col])||'').localeCompare(b.getAttribute(m[col])||'')*sort.dir;
    });
    rows.forEach(function(row){
        var sid=row.getAttribute('data-key').replace(/[^a-zA-Z0-9]/g,'_');
        var er=document.getElementById('er-'+sid);
        tbody.appendChild(row); if(er) tbody.appendChild(er);
    });
    document.querySelectorAll('th.sortable').forEach(function(th){th.classList.remove('sort-asc','sort-desc');});
    var active=document.querySelector('th.sortable[data-col="'+col+'"]');
    if(active) active.classList.add(sort.dir===1?'sort-asc':'sort-desc');
    currentPage=1; renderPage();
}
document.querySelectorAll('th.sortable').forEach(function(th){
    th.addEventListener('click',function(){sortTable(th.getAttribute('data-col'));});
});

// ── Pagination ─────────────────────────────────────────────────────────────
var currentPage = 1;

function getPageSize() {
    return parseInt(document.getElementById('pg-size').value, 10) || 0;
}

// Returns all data rows (tr[data-key]) that pass the current filters, in DOM order.
function getVisibleDataRows() {
    var ov=document.getElementById('f-outcome').value;
    var cv=document.getElementById('f-class').value;
    var sv=document.getElementById('f-search').value.toLowerCase();
    return Array.from(document.querySelectorAll('#test-tbody tr[data-key]')).filter(function(row){
        var ro=row.getAttribute('data-outcome')||'Pending';
        var rc=row.getAttribute('data-class')||'';
        var rk=(row.getAttribute('data-key')||'').toLowerCase();
        var label=(row.querySelector('.test-label')||{}).textContent||'';
        return (!ov||ro===ov)&&(!cv||rc===cv)&&(!sv||rk.includes(sv)||label.toLowerCase().includes(sv));
    });
}

function renderPage() {
    var pageSize = getPageSize();
    var allVisible = getVisibleDataRows();
    var total = allVisible.length;
    var totalPages = pageSize > 0 ? Math.max(1, Math.ceil(total / pageSize)) : 1;
    if (currentPage > totalPages) currentPage = totalPages;

    var from = pageSize > 0 ? (currentPage - 1) * pageSize : 0;
    var to   = pageSize > 0 ? Math.min(from + pageSize, total) : total;

    // Show/hide every data row and its paired error row
    document.querySelectorAll('#test-tbody tr[data-key]').forEach(function(row, domIdx) {
        var sid = row.getAttribute('data-key').replace(/[^a-zA-Z0-9]/g,'_');
        var er  = document.getElementById('er-'+sid);
        var inFilter = allVisible.indexOf(row) !== -1;
        var inPage   = pageSize === 0 || (allVisible.indexOf(row) >= from && allVisible.indexOf(row) < to);
        var show = inFilter && inPage;
        row.style.display = show ? '' : 'none';
        if (er) er.style.display = show && er.querySelector('.err-box').style.display === 'block' ? '' : 'none';
    });

    // Update info text
    document.getElementById('pg-from').textContent  = total === 0 ? 0 : from + 1;
    document.getElementById('pg-to').textContent    = to;
    document.getElementById('pg-total').textContent = total;

    // Render page buttons
    renderPaginationControls(currentPage, totalPages);
}

function renderPaginationControls(page, totalPages) {
    var container = document.getElementById('pg-controls');
    while (container.firstChild) container.removeChild(container.firstChild);
    if (totalPages <= 1) return;

    function makeBtn(label, targetPage, isActive, disabled, isIcon) {
        var btn = document.createElement('button');
        btn.className = 'pg-btn' + (isActive ? ' pg-active' : '');
        btn.disabled  = !!disabled;
        if (isIcon) {
            var ic = document.createElement('span');
            ic.className = 'glyphicon ' + label;
            btn.appendChild(ic);
        } else {
            btn.textContent = String(label);
        }
        if (!disabled && !isActive) {
            btn.addEventListener('click', function(){ currentPage = targetPage; renderPage(); });
        }
        return btn;
    }

    function makeEllipsis() {
        var s = document.createElement('span'); s.className = 'pg-ellipsis'; s.textContent = '…'; return s;
    }

    container.appendChild(makeBtn('glyphicon-step-backward', 1,      false, page===1, true));
    container.appendChild(makeBtn('glyphicon-chevron-left',  page-1, false, page===1, true));

    // Smart windowed page numbers: always show first, last, current ±2
    var pages = [];
    for (var i=1; i<=totalPages; i++) {
        if (i===1 || i===totalPages || (i>=page-2 && i<=page+2)) pages.push(i);
    }
    var prev = 0;
    pages.forEach(function(p) {
        if (prev && p - prev > 1) container.appendChild(makeEllipsis());
        container.appendChild(makeBtn(p, p, p===page, false, false));
        prev = p;
    });

    container.appendChild(makeBtn('glyphicon-chevron-right', page+1,      false, page===totalPages, true));
    container.appendChild(makeBtn('glyphicon-step-forward',  totalPages,  false, page===totalPages, true));
}

// ── Filters — delegate to renderPage ──────────────────────────────────────
function applyFilters() { currentPage = 1; renderPage(); }

['f-outcome','f-class','f-search'].forEach(function(id){
    var el=document.getElementById(id);
    el.addEventListener('input',applyFilters); el.addEventListener('change',applyFilters);
});
document.getElementById('pg-size').addEventListener('change', function(){ currentPage=1; renderPage(); });

// Initial render
renderPage();

// ── Sync on load ───────────────────────────────────────────────────────────
fetch('/TestDashboard/Status').then(function(r){return r.json();})
.then(function(data){
    if(data.status==='Running'){
        activeRunId=data.runId||null;
        document.getElementById('btn-run').disabled=true;
        document.getElementById('btn-icon').className='spin glyphicon glyphicon-refresh';
        document.getElementById('btn-txt').textContent='Running…';
        setStatus('Running'); startTimer(); startPolling();
    } else if(data.status==='Completed'||data.status==='Failed'){
        updateDashboard(data);
    }
}).catch(function(){});
})();
</script>
