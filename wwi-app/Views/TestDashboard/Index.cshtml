function updateCharts(passed, failed, pending, results) {
    // Donut
    cDonut.data.datasets[0].data = [passed, failed, pending];
    cDonut.update('none');
    document.getElementById('leg-p').textContent = passed;
    document.getElementById('leg-f').textContent = failed;
    document.getElementById('leg-n').textContent = pending;

    if (!results || results.length === 0) return;

    // Slowest bar
    var sorted = results.filter(function(r){return r.durationMs>0;})
        .sort(function(a,b){return b.durationMs-a.durationMs;}).slice(0,10);
    cBar.data.labels = sorted.map(function(r){ return humanise(r.methodName).label; });
    cBar.data.datasets[0].data = sorted.map(function(r){ return Math.round(r.durationMs); });
    cBar.update('none');

    // Class breakdown
    var classMap = {};
    results.forEach(function(r) {
        if (!classMap[r.className]) classMap[r.className] = {p:0,f:0};
        if (r.outcome==='Passed') classMap[r.className].p++;
        else if (r.outcome==='Failed') classMap[r.className].f++;
    });
    var classes = Object.keys(classMap);
    cClass.data.labels = classes.map(humaniseClass);
    cClass.data.datasets[0].data = classes.map(function(c){return classMap[c].p;});
    cClass.data.datasets[1].data = classes.map(function(c){return classMap[c].f;});
    cClass.update('none');

    // Timeline scatter
    var passP=[], failP=[], skipP=[];
    results.forEach(function(r, i) {
        var pt = { x: i+1, y: Math.round(r.durationMs||0), name: humanise(r.methodName).label };
        if (r.outcome==='Passed')      passP.push(pt);
        else if (r.outcome==='Failed') failP.push(pt);
        else                           skipP.push(pt);
    });
    cTimeline.data.datasets[0].data = passP;
    cTimeline.data.datasets[1].data = failP;
    cTimeline.data.datasets[2].data = skipP;
    cTimeline.update('none');
}

function refreshTrendChart() {
    var history = loadHistory();
    if (!history.length) return;
    var trimmed = history.slice().reverse(); // oldest first
    cTrend.data.labels = trimmed.map(function(_, i){ return 'Run '+(i+1); });
    cTrend.data.datasets[0].data = trimmed.map(function(r){
        return r.total > 0 ? Math.round(r.passed/r.total*100) : 0;
    });
    cTrend.update('none');
}

// ── Run history ────────────────────────────────────────────────────────────
function loadHistory() {
    try { return JSON.parse(localStorage.getItem(HIST_KEY)||'[]'); } catch(e){ return []; }
}
function saveHistory(entry) {
    var h=loadHistory(); h.unshift(entry);
    if (h.length>MAX_HIST) h.length=MAX_HIST;
    localStorage.setItem(HIST_KEY, JSON.stringify(h));
    renderHistory(h); refreshTrendChart();
}
function renderHistory(history) {
    var tbody=document.getElementById('hist-tbody');
    document.getElementById('hist-cnt').textContent = history.length || '';
    while(tbody.firstChild) tbody.removeChild(tbody.firstChild);
    if (!history.length) {
        var tr=tbody.insertRow(); var td=tr.insertCell();
        td.colSpan=7; td.style.cssText='padding:16px;text-align:center;color:var(--muted)';
        td.textContent='No runs recorded yet.'; return;
    }
    history.forEach(function(r,i) {
        var rate=r.total>0?Math.round(r.passed/r.total*100):0;
        var dur=r.durationMs>0?(r.durationMs>=60000
            ?Math.floor(r.durationMs/60000)+'m '+Math.round((r.durationMs%60000)/1000)+'s'
            :Math.round(r.durationMs/1000)+'s'):'—';
        var t=new Date(r.timestamp);
        var tr=tbody.insertRow();
        tr.className=r.failed>0?'h-fail':r.passed>0?'h-pass':'';

        var c0=tr.insertCell(); c0.textContent=String(i+1); c0.style.color='var(--muted)';
        var c1=tr.insertCell(); c1.textContent=t.toLocaleDateString()+' '+t.toLocaleTimeString();
        c1.title='Run '+(r.runId||'').substring(0,8); c1.style.fontSize='11px';

        var c2=tr.insertCell(); var p2=document.createElement('span');
        p2.className='pill pill-p'; p2.textContent='✓ '+r.passed; c2.appendChild(p2);

        var c3=tr.insertCell();
        if (r.failed>0){var p3=document.createElement('span');p3.className='pill pill-f';p3.textContent='✗ '+r.failed;c3.appendChild(p3);}
        else{c3.textContent='—';c3.style.color='var(--muted)';}

        var c4=tr.insertCell(); c4.textContent=String(r.total);
        var c5=tr.insertCell(); c5.textContent=dur; c5.style.color='var(--muted)';

        var c6=tr.insertCell();
        var wrap=document.createElement('div');
        wrap.style.cssText='display:flex;align-items:center;gap:7px;font-size:12px;font-weight:700;color:'+(r.failed>0?'#ef4444':'#10b981');
        wrap.textContent=rate+'%';
        var bw=document.createElement('div'); bw.className='mini-track';
        var bf=document.createElement('div'); bf.className='mini-fill';
        bf.style.cssText='width:'+rate+'%;background:'+(r.failed>0?'#ef4444':'#10b981');
        bw.appendChild(bf); wrap.appendChild(bw); c6.appendChild(wrap);
    });
}
