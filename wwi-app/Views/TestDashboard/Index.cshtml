// ── Status helpers ─────────────────────────────────────────────────────────
function setStatus(s) {
    var el=document.getElementById('status-badge');
    el.className='td-badge';
    if (s==='Running') {
        el.className+=' run';
        el.innerHTML='<span class="spin glyphicon glyphicon-refresh" style="font-size:9px"></span> RUNNING';
    } else if (s==='Completed') {
        el.className+=' done';
        el.innerHTML='<span class="glyphicon glyphicon-ok" style="font-size:9px"></span> PASSED';
    } else if (s==='Failed') {
        el.className+=' fail';
        el.innerHTML='<span class="glyphicon glyphicon-remove" style="font-size:9px"></span> FAILED';
    } else {
        el.innerHTML='<span class="glyphicon glyphicon-minus" style="font-size:9px"></span> IDLE';
    }
}
function resetBtn() {
    var btn=document.getElementById('btn-run');
    btn.disabled=false;
    document.getElementById('btn-icon').className='glyphicon glyphicon-play';
    document.getElementById('btn-txt').textContent='Run Tests';
}
function setProgress(done, total, running, allPass, anyFail) {
    var pct=total>0?Math.round(done/total*100):0;
    var fill=document.getElementById('prog');
    fill.style.width=Math.min(pct,100)+'%';
    fill.className='td-prog-fill'+(running?' live':anyFail?' c-fail':allPass&&done>0?' c-pass':'');
    document.getElementById('prog-done').textContent=done+' / '+total+' done';
    document.getElementById('prog-pct').textContent=pct+'%';
    document.getElementById('m-pass').textContent=allPass||anyFail?String(done-(anyFail?1:0)):String(0);
}
function setMetrics(passed,failed,pending) {
    document.getElementById('m-pass').textContent=String(passed);
    document.getElementById('m-fail').textContent=String(failed);
    document.getElementById('m-pend').textContent=String(pending);
    document.getElementById('m-pass').className='td-mnum '+(passed>0?'c-pass':'c-idle');
    document.getElementById('m-fail').className='td-mnum '+(failed>0?'c-fail':'c-idle');
    document.getElementById('m-pend').className='td-mnum c-idle';
}

function startTimer(){startTime=Date.now();timerHandle=setInterval(function(){
    var ms=Date.now()-startTime,s=Math.floor(ms/1000),m=Math.floor(s/60);s=s%60;
    document.getElementById('elapsed').textContent=(m>0?m+'m ':'')+s+'s';
},500);}
function stopTimer(){if(timerHandle){clearInterval(timerHandle);timerHandle=null;}}

// ── Dashboard update ───────────────────────────────────────────────────────
function updateDashboard(data) {
    setStatus(data.status);
    var s=data.summary||{};
    var passed=s.passed||0, failed=s.failed||0, total=s.total||TOTAL;
    var pending=Math.max(0, TOTAL-passed-failed);
    var running=data.status==='Running';

    setMetrics(passed, failed, pending);
    var done=passed+failed;
    var fill=document.getElementById('prog');
    fill.style.width=TOTAL>0?Math.min(Math.round(done/TOTAL*100),100)+'%':'0%';
    fill.className='td-prog-fill'+(running?' live':failed>0?' c-fail':passed>0&&done===TOTAL?' c-pass':'');
    document.getElementById('prog-done').textContent=done+' / '+TOTAL+' done';
    document.getElementById('prog-pct').textContent=TOTAL>0?Math.round(done/TOTAL*100)+'%':'0%';

    if (data.runId) document.getElementById('run-id-lbl').textContent='Run #'+(data.runId||'').substring(0,8);

    updateCharts(passed, failed, pending, data.results);

    var hasFailed=false;
    (data.results||[]).forEach(function(r) {
        var key=r.className+'.'+r.methodName;
        var row=document.querySelector('tr[data-key="'+CSS.escape(key)+'"]');
        if (!row) return;
        row.setAttribute('data-outcome', r.outcome);
        row.setAttribute('data-duration', r.durationMs||0);

        var badge=row.querySelector('.ob');
        var dot='<span class="ob-dot"></span>';
        if (r.outcome==='Passed')          { badge.className='ob ob-pass'; badge.innerHTML=dot+'Passed'; }
        else if (r.outcome==='Failed')     { badge.className='ob ob-fail'; badge.innerHTML=dot+'Failed'; hasFailed=true; }
        else if (r.outcome==='NotExecuted'){ badge.className='ob ob-skip'; badge.innerHTML=dot+'Skipped'; }
        else                               { badge.className='ob ob-pend'; badge.innerHTML=dot+'Pending'; }

        var exp=row.querySelector('.test-expected');
        if (r.outcome==='Passed')      exp.className='test-expected exp-pass';
        else if (r.outcome==='Failed') exp.className='test-expected exp-fail';
        else                           exp.className='test-expected';

        var dur=row.querySelector('.dur');
        if (r.durationMs>0) {
            var ms=Math.round(r.durationMs);
            dur.textContent=ms+' ms';
            dur.className='dur'+(ms>2000?' slow':ms>500?' med':'');
        }

        if (r.outcome==='Failed') {
            row.classList.add('tr-fail');
            var sid=key.replace(/[^a-zA-Z0-9]/g,'_');
            var eb=document.getElementById('eb-'+sid);
            if (eb&&r.errorMessage){ eb.textContent=r.errorMessage; eb.style.display='block'; }
            var er=document.getElementById('er-'+sid);
            if (er) er.style.display='';
        } else {
            row.classList.remove('tr-fail');
        }
    });

    document.getElementById('btn-copy').style.display=hasFailed?'block':'none';
    renderPage();

    if (data.status==='Completed'||data.status==='Failed') {
        stopPolling(); stopTimer(); resetBtn();
        document.getElementById('prog').classList.remove('live');
        saveHistory({ runId:data.runId, timestamp:Date.now(),
            passed:passed, failed:failed, total:TOTAL,
            durationMs:startTime?Date.now()-startTime:0 });
    }
}

function stopPolling(){ if(pollInterval){clearInterval(pollInterval);pollInterval=null;} }
function startPolling(){
    pollInterval=setInterval(function(){
        fetch('/TestDashboard/Status').then(function(r){return r.json();})
        .then(function(data){
            if(activeRunId&&data.runId&&data.runId!==activeRunId) return;
            updateDashboard(data);
        }).catch(function(){});
    },1000);
}

// ── Run Tests button ───────────────────────────────────────────────────────
document.getElementById('btn-run').addEventListener('click', function(){
    stopPolling(); stopTimer();
    document.getElementById('err-banner').style.display='none';
    this.disabled=true;
    document.getElementById('btn-icon').className='spin glyphicon glyphicon-refresh';
    document.getElementById('btn-txt').textContent='Running…';
    setStatus('Running'); startTimer();

    // Reset all rows
    document.querySelectorAll('#test-tbody tr[data-key]').forEach(function(row){
        row.setAttribute('data-outcome','Pending');
        row.setAttribute('data-duration','0');
        row.classList.remove('tr-fail');
        var badge=row.querySelector('.ob'); badge.className='ob ob-pend';
        badge.innerHTML='<span class="ob-dot"></span>Pending';
        var dur=row.querySelector('.dur'); dur.textContent='—'; dur.className='dur';
        var exp=row.querySelector('.test-expected'); exp.className='test-expected';
    });
    document.querySelectorAll('.err-row').forEach(function(r){r.style.display='none';});
    document.querySelectorAll('.err-box').forEach(function(d){d.textContent='';d.style.display='none';});

    setMetrics(0,0,TOTAL);
    var fill=document.getElementById('prog');
    fill.style.width='0%'; fill.className='td-prog-fill live';
    document.getElementById('prog-done').textContent='0 / '+TOTAL+' done';
    document.getElementById('prog-pct').textContent='0%';
    updateCharts(0,0,TOTAL,[]);

    var csrf=(document.querySelector('input[name="__RequestVerificationToken"]')||{}).value||'';
    fetch('/TestDashboard/Run',{method:'POST',headers:{'RequestVerificationToken':csrf}})
    .then(function(r){
        if(r.status===409){
            resetBtn(); setStatus('Idle'); stopTimer();
            showErr('A test run is already in progress.'); return;
        }
        if(!r.ok) return r.text().then(function(b){throw new Error('HTTP '+r.status+': '+b.substring(0,200));});
        return r.json().then(function(data){activeRunId=data.runId||null; startPolling();});
    })
    .catch(function(err){
        resetBtn(); setStatus('Idle'); stopTimer();
        showErr('Could not start: '+((err&&err.message)?err.message:'Network error'));
    });
});

function showErr(msg){ var el=document.getElementById('err-banner'); el.textContent=msg; el.style.display=''; }

